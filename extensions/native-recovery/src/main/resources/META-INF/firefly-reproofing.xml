<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
  <changeSet id="firefly-independent-reproofing-1" author="firefly-id">
    <createTable tableName="ff_reproofing_state">
      <column name="id" type="VARCHAR(128)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="realm_id" type="VARCHAR(512)"></column>
      <column name="subject" type="VARCHAR(512)"></column>
      <column name="epoch" type="VARCHAR(128)"></column>
      <column name="failures" type="INT"></column>
    </createTable>
    <createTable tableName="ff_reproofing_ceremony">
      <column name="id" type="VARCHAR(128)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="realm_id" type="VARCHAR(512)"></column>
      <column name="subject" type="VARCHAR(512)"></column>
      <column name="binding_json" type="VARCHAR(8192)"></column>
      <column name="csrf_digest" type="VARCHAR(128)"></column>
      <column name="stage" type="VARCHAR(32)"></column>
      <column name="expires_at" type="BIGINT"></column>
      <column name="case_id" type="VARCHAR(64)"></column>
      <column name="authorization_json" type="VARCHAR(8192)"></column>
      <column name="verification_url" type="VARCHAR(2048)"></column>
      <column name="encrypted_totp" type="VARCHAR(2048)"></column>
      <column name="notification_destination" type="VARCHAR(512)"></column>
      <column name="failed" type="BOOLEAN"></column>
    </createTable>
    <createTable tableName="ff_reproofing_execution">
      <column name="id" type="VARCHAR(64)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="realm_id" type="VARCHAR(512)"></column>
      <column name="ceremony_id" type="VARCHAR(128)"></column>
      <column name="case_id" type="VARCHAR(64)"></column>
      <column name="authorization_id" type="VARCHAR(64)"></column>
      <column name="binding_json" type="VARCHAR(8192)"></column>
      <column name="authorization_json" type="VARCHAR(8192)"></column>
      <column name="committed_at" type="BIGINT"></column>
      <column name="recorded" type="BOOLEAN"></column>
      <column name="record_attempts" type="INT"></column>
    </createTable>
    <createTable tableName="ff_reproofing_notification">
      <column name="id" type="VARCHAR(64)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="realm_id" type="VARCHAR(512)"></column>
      <column name="subject" type="VARCHAR(512)"></column>
      <column name="destination_encrypted" type="VARCHAR(2048)"></column>
      <column name="destination_digest" type="VARCHAR(128)"></column>
      <column name="created_at" type="BIGINT"></column>
      <column name="next_attempt_at" type="BIGINT"></column>
      <column name="delivered_at" type="BIGINT"></column>
      <column name="attempts" type="INT"></column>
      <column name="status" type="VARCHAR(32)"></column>
    </createTable>
    <addUniqueConstraint tableName="ff_reproofing_state" columnNames="realm_id,subject" constraintName="ff_reproofing_subject_epoch"/>
    <addUniqueConstraint tableName="ff_reproofing_execution" columnNames="ceremony_id" constraintName="ff_reproofing_execution_once"/>
    <addUniqueConstraint tableName="ff_reproofing_execution" columnNames="authorization_id" constraintName="ff_reproofing_grant_once"/>
    <createIndex tableName="ff_reproofing_notification" indexName="ff_reproofing_notification_pending"><column name="status"/><column name="next_attempt_at"/></createIndex>
  </changeSet>
  <changeSet id="firefly-independent-reproofing-fences-1" author="firefly-id">
    <addColumn tableName="ff_reproofing_notification"><column name="lease_token" type="VARCHAR(64)"/></addColumn>
    <addNotNullConstraint tableName="ff_reproofing_state" columnName="realm_id" columnDataType="VARCHAR(512)"/>
    <addNotNullConstraint tableName="ff_reproofing_state" columnName="subject" columnDataType="VARCHAR(512)"/>
    <addNotNullConstraint tableName="ff_reproofing_state" columnName="epoch" columnDataType="VARCHAR(128)"/>
    <addNotNullConstraint tableName="ff_reproofing_state" columnName="failures" columnDataType="INT"/>
    <addNotNullConstraint tableName="ff_reproofing_ceremony" columnName="realm_id" columnDataType="VARCHAR(512)"/>
    <addNotNullConstraint tableName="ff_reproofing_ceremony" columnName="csrf_digest" columnDataType="VARCHAR(128)"/>
    <addNotNullConstraint tableName="ff_reproofing_ceremony" columnName="stage" columnDataType="VARCHAR(32)"/>
    <addNotNullConstraint tableName="ff_reproofing_ceremony" columnName="expires_at" columnDataType="BIGINT"/>
    <addNotNullConstraint tableName="ff_reproofing_execution" columnName="realm_id" columnDataType="VARCHAR(512)"/>
    <addNotNullConstraint tableName="ff_reproofing_execution" columnName="ceremony_id" columnDataType="VARCHAR(128)"/>
    <addNotNullConstraint tableName="ff_reproofing_execution" columnName="case_id" columnDataType="VARCHAR(64)"/>
    <addNotNullConstraint tableName="ff_reproofing_execution" columnName="authorization_id" columnDataType="VARCHAR(64)"/>
    <addNotNullConstraint tableName="ff_reproofing_execution" columnName="binding_json" columnDataType="VARCHAR(8192)"/>
    <addNotNullConstraint tableName="ff_reproofing_execution" columnName="authorization_json" columnDataType="VARCHAR(8192)"/>
    <addNotNullConstraint tableName="ff_reproofing_notification" columnName="realm_id" columnDataType="VARCHAR(512)"/>
    <addNotNullConstraint tableName="ff_reproofing_notification" columnName="subject" columnDataType="VARCHAR(512)"/>
    <addNotNullConstraint tableName="ff_reproofing_notification" columnName="destination_encrypted" columnDataType="VARCHAR(2048)"/>
    <addNotNullConstraint tableName="ff_reproofing_notification" columnName="destination_digest" columnDataType="VARCHAR(128)"/>
    <addNotNullConstraint tableName="ff_reproofing_notification" columnName="status" columnDataType="VARCHAR(32)"/>
  </changeSet>
  <changeSet id="firefly-independent-reproofing-checks-1" author="firefly-id" dbms="postgresql">
    <sql>ALTER TABLE ff_reproofing_state ADD CONSTRAINT ff_reproofing_failure_bound CHECK (failures BETWEEN 0 AND 3)</sql>
    <sql>ALTER TABLE ff_reproofing_notification ADD CONSTRAINT ff_reproofing_delivery_bound CHECK (attempts BETWEEN 0 AND 8 AND status IN ('PENDING','SENDING','DELIVERED','FAILED'))</sql>
    <sql>ALTER TABLE ff_reproofing_ceremony ADD CONSTRAINT ff_reproofing_stage CHECK (stage IN ('IDENTIFY','VERIFY','ENROLL','COMPLETE'))</sql>
  </changeSet>
</databaseChangeLog>
