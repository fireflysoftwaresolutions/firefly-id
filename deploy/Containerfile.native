FROM quay.io/keycloak/keycloak:26.8.1@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332 AS builder
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true
COPY --chown=keycloak:keycloak dist/firefly-id-theme.jar /opt/keycloak/providers/firefly-id-theme.jar
COPY --chown=keycloak:keycloak dist/native/providers/ /opt/keycloak/providers/
COPY --chown=keycloak:keycloak config/password-blacklist.txt /opt/keycloak/data/password-blacklists/firefly-baseline.txt
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.8.1@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332
COPY --from=builder /opt/keycloak/ /opt/keycloak/
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--spi-theme--default=firefly-id"]
